UMR_REPOSITORY=/opt/umr
UMR_GIT_COMMIT=PIN_A_TESTED_FULL_COMMIT
UMR_PYTHON=/opt/conda/envs/umr/bin/python
UMR_SMPL_ROOT=/secure/models/smpl
ARTIFACT_ROOT=/srv/umr-agent/projects
WORKER_MAX_CPU=12
WORKER_MAX_MEMORY_GIB=32
WORKER_MAX_RUNTIME_SECONDS=14400
WORKER_NETWORK=disabled
UMR_AGENT_CATALOG=examples/catalog.example.json
# Set a unique random value of at least 32 characters through scripts/setup_local_token.py.
UMR_AGENT_API_TOKEN=
UMR_AGENT_OLLAMA_URL=http://127.0.0.1:11434
UMR_AGENT_OLLAMA_MODEL=gemma3:4b
